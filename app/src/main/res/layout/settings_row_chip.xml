<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#FFFFFF"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:tint="#4F8EF7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Title"
        android:textStyle="bold"
        android:textColor="#111111"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@id/rowIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rowChip"
        android:layout_marginStart="12dp" />

    <TextView
        android:id="@+id/rowSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Subtitle"
        android:textColor="#7A8699"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/rowTitle"
        app:layout_constraintTop_toBottomOf="@id/rowTitle"
        app:layout_constraintEnd_toStartOf="@id/rowChip" />

    <TextView
        android:id="@+id/rowChip"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:gravity="center"
        android:text="Action"
        android:textStyle="bold"
        android:textSize="12sp"
        android:background="@drawable/chip_outline_blue"
        android:textColor="#4F8EF7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
